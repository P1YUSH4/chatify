PORT=3000
NODE_ENV=production

# MongoDB Atlas connection string
MONGO_URI=

# Long random string used to sign auth cookies
JWT_SECRET=

# Frontend origin (Vercel URL). No trailing slash.
# Example: https://chatify.vercel.app
CLIENT_URL=

# Resend (transactional email)
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev
EMAIL_FROM_NAME=Chatify

# Cloudinary (profile picture uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Arcjet (bot/abuse protection)
ARCJET_KEY=
ARCJET_ENV=production
